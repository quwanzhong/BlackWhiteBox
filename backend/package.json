{
  "name": "heibaihe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "黑百盒测试平台 - 后端：流程执行引擎 / 校验器 / WebSocket 实时推送 / OpenAPI 导入",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "verify:e2e": "node scripts/verify-e2e-flow.mjs",
    "verify:scenes": "node scripts/verify-e2e-scenes.mjs",
    "verify": "npm run verify:e2e && npm run verify:scenes",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/engine/**/*.js --test-coverage-include=src/projects/scanner.js --test-coverage-include=src/infra/store/**/*.js --test-coverage-include=src/security/**/*.js --test-coverage-lines=70 --test-coverage-branches=70 --test-coverage-functions=70"
  },
  "dependencies": {
    "apifox-mcp-server": "^0.0.18",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "socket.io-client": "^4.8.4"
  }
}
